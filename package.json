{
  "name": "babelangue-desktop",
  "version": "1.0.0",
  "description": "Desktop application for Babelangue vocabulary trainer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "build-all": "electron-builder -mwl"
  },
  "keywords": [
    "vocabulary",
    "language",
    "learning",
    "flashcards"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.babelangue.app",
    "productName": "Babelangue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "flasktest.py",
      "BABELANGUE_alpha1.py",
      "templates/**/*",
      "static/**/*",
      "data/**/*",
      "deepl_api_key.env",
      "requirements.txt"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "static/babelangue_logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "static/babelangue_logo.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "static/babelangue_logo.png",
      "category": "Education"
    }
  }
}